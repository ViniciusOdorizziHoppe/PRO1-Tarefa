package com.mycompany.usuario;

import java.util.Date;

/**
 *
 * @author aluno
 */
public class Ocorrencia {

    private int identificadorDaOcorrencia;
    private String tipo;
    private String hora;
    private String status;
    private Date data;

    public int getIdentificadorDaOcorrencia() {
        return identificadorDaOcorrencia;
    }

    public void setIdentificadorDaOcorrencia(int identificadorDaOcorrencia) {
        this.identificadorDaOcorrencia = identificadorDaOcorrencia;
    }

    public String getTipo() {
        return tipo;
    }

    public void setTipo(String tipo) {
        this.tipo = tipo;
    }

    public String getHora() {
        return hora;
    }

    public void setHora(String hora) {
        this.hora = hora;
    }

    public String getStatus() {
        return status;
    }

    public void setStatus(String status) {
        this.status = status;
    }

    public Date getData() {
        return data;
    }

    public void setData(Date data) {
        this.data = data;
    }

}
